erDiagram
    users ||--o{ posts : "menulis"
    users ||--o{ comments : "menulis"
    users ||--o{ likes : "memberi"
    users ||--o{ follows : "mengikuti (follower_id)"
    users ||--o{ follows : "diikuti (followed_id)"
    posts ||--o{ comments : "dikomentari"
    posts ||--o{ likes : "disukai"
    posts ||--o{ post_hashtags : "memiliki"
